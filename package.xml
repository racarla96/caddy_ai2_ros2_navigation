<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caddy_ai2_ros2_navigation</name>
  <version>0.0.0</version>
  <description>Navigation package for the Caddy AI2 agricultural robot — SLAM mapping and EasyNav navigation (Ackermann kinematics)</description>
  <maintainer email="rafapenya96@gmail.com">racarla96</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- SLAM -->
  <depend>cartographer_ros</depend>
  <depend>slam_toolbox</depend>

  <!-- Navigation: EasyNav (built from source, tag 0.5.0, see README) -->
  <depend>easynav_system</depend>
  <depend>easynav_costmap_maps_manager</depend>
  <depend>easynav_costmap_localizer</depend>
  <depend>easynav_costmap_planner</depend>
  <depend>easynav_regulated_pp_controller</depend>
  <depend>easynav_diagnostic_recovery</depend>

  <!-- map_saver_cli: saves the slam_toolbox map as PGM + YAML for EasyNav's costmap maps manager -->
  <exec_depend>nav2_map_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
