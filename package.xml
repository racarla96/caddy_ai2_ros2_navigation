<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caddy_ai2_ros2_navigation</name>
  <version>0.0.0</version>
  <description>Navigation package for the Caddy AI2 agricultural robot — SLAM, AMCL and Nav2 with Ackermann kinematics</description>
  <maintainer email="rafapenya96@gmail.com">racarla96</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Localization -->
  <depend>slam_toolbox</depend>
  <depend>nav2_amcl</depend>

  <!-- Navigation -->
  <depend>nav2_bringup</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_smoother</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_waypoint_follower</depend>

  <!-- Twist adapter: Nav2 publishes Twist, controller expects TwistStamped -->
  <!-- Install: sudo apt install ros-jazzy-twist-stamper -->
  <depend>twist_stamper</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
