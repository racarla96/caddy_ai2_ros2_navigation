Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz_default_plugins/PointCloud2
      Name: Mapa circuito (local)
      Enabled: true
      Topic:
        Value: /viz_cloud
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Style: Flat Squares
      Size (m): 0.15
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 5
      Use Fixed Frame: true
      Use rainbow: true
      Min Color: 0; 0; 0
      Max Color: 255; 255; 255
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 1.5
    - Class: rviz_default_plugins/RobotModel
      Name: Caddy
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /caddy_ai2/robot_description_local
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Camino A*
      Enabled: true
      Topic:
        Value: /planner_node/astar/path
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.12
    - Class: rviz_default_plugins/PoseArray
      Name: Particulas AMCL
      Enabled: true
      Topic:
        Value: /localizer_node/amcl/particles
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow (Flat)
      Arrow Length: 0.5
      Color: 255; 25; 0
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_footprint    # the camera follows the vehicle
      Distance: 16
      Pitch: 0.65
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 850
  Width: 1300
