Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 1.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Helios (sin autoimpacto)
      Enabled: true
      Topic:
        Value: /caddy_ai2/rs_helios_5515/points_filtered
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/Path
      Name: Camino A*
      Enabled: true
      Topic:
        Value: /planner_node/astar/path
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.12
    - Class: rviz_default_plugins/PoseArray
      Name: Particulas AMCL
      Enabled: true
      Topic:
        Value: /localizer_node/amcl/particles
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow (Flat)
      Arrow Length: 0.5
      Color: 255; 25; 0
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Pitch: 0.9
      Yaw: 3.14
      Focal Point:
        X: 3
        Y: 0
        Z: 0
Window Geometry:
  Height: 850
  Width: 1300
